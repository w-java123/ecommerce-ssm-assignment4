<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 命名空间必须与 UserMapper 接口全限定名一致 -->
<mapper namespace="com.wangzhoujun202401150317.mapper.UserMapper">

    <resultMap type="Users" id="usersResult">
        <id     property="id"       column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email"    column="email"/>
    </resultMap>

    <resultMap type="Users" id="UserWithOrdersResult" extends="usersResult">
        <!-- 使用左连接一次性查出用户及其订单 -->
        <collection property="orderList" ofType="Orders" notNullColumn="oid">
            <id     property="id"        column="oid"/>
            <result property="userId"    column="user_id"/>
            <result property="orderDate" column="order_date"/>
        </collection>
    </resultMap>

    <select id="findUserWithOrders" parameterType="int"
            resultMap="UserWithOrdersResult">
        select u.id, u.username, u.email,
               o.id as oid, o.user_id, o.order_date
        from users u
        left join orders o on u.id = o.user_id
        where u.id = #{id}
        order by o.id
    </select>

</mapper>
